<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PrivEat Vault"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pin_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Enter PIN"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <GridLayout
        android:id="@+id/pin_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:columnCount="3"
        android:rowCount="4">

        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="1" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="2" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="3" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="4" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="5" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="6" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="7" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="8" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="9" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_biometric"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="Bio" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="80dp" android:layout_height="80dp" android:text="0" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="Del" />
    </GridLayout>

</LinearLayout>
